<!DOCTYPE html>
<html data-theme="cerberus">
  <head>
    <title>Yancy Editor</title>
    %= stylesheet '/editor/editor.css'
    <!-- XXX: Editor needs a basic stylesheet and/or a way to customize one -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.conditional.min.css">
    %= javascript begin
      window.Yancy ||= {};
      Yancy.base = "<%== stash('base') %>";
    % end
    %= javascript type => 'module', defer => '', src => '/editor/editor.es.js'
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
